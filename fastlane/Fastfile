# Signs, builds and uploads to TestFlight. Run by .github/workflows/build.yml.
#
# match keeps one Apple Distribution certificate and App Store profile, encrypted with
# MATCH_PASSWORD, on a git branch (`certificates` in this repo unless MATCH_GIT_URL points
# elsewhere). The first run creates them through the App Store Connect API; later runs
# reuse them and renew the profile when it expires.
require "yaml"
require "shellwords"

default_platform(:ios)

platform :ios do
  desc "Sign, build and upload to TestFlight"
  lane :beta do
    # Ruby code here runs from ./fastlane, actions run from the repo root.
    bundle_id = YAML.load_file("../project.yml").dig("targets", "Encore", "settings", "base", "PRODUCT_BUNDLE_IDENTIFIER")
    team_id = ENV.fetch("APPLE_TEAM_ID").strip
    build_number = ENV.fetch("BUILD_NUMBER", "1")
    UI.message("Building #{bundle_id} (build #{build_number}) for team #{team_id}")

    key = ENV.fetch("ASC_KEY_P8").gsub("\\n", "\n").strip
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID").strip,
      issuer_id: ENV.fetch("ASC_ISSUER_ID").strip,
      key_content: key,
      # Accept either the .p8 text or the whole file base64-encoded.
      is_key_content_base64: !key.include?("BEGIN PRIVATE KEY")
    )

    setup_ci # temporary keychain for the certificate

    match(
      type: "appstore",
      app_identifier: bundle_id,
      team_id: team_id,
      api_key: api_key,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_branch: "certificates",
      git_basic_authorization: ENV.fetch("MATCH_GIT_BASIC_AUTHORIZATION"),
      git_full_name: "github-actions[bot]",
      git_user_email: "41898282+github-actions[bot]@users.noreply.github.com",
      readonly: false # setup_ci turns readonly on; we want creation on the first run
    )
    profile = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][bundle_id]

    build_app(
      project: "Encore.xcodeproj",
      scheme: "Encore",
      configuration: "Release",
      destination: "generic/platform=iOS",
      output_directory: "build",
      output_name: "Encore.ipa",
      buildlog_path: "build/logs",
      export_method: "app-store",
      export_team_id: team_id,
      export_options: {
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: { bundle_id => profile }
      },
      xcargs: [
        "DEVELOPMENT_TEAM=#{team_id.shellescape}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY=#{'Apple Distribution'.shellescape}",
        "PROVISIONING_PROFILE_SPECIFIER=#{profile.shellescape}",
        "CURRENT_PROJECT_VERSION=#{build_number.shellescape}"
      ].join(" ")
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
    UI.success("Uploaded build #{build_number}. It shows up in TestFlight once Apple finishes processing (usually 5–30 min).")
  end
end
